@using Nine.Core.Constants
@using Nine.Core.Entities
@using Nine.Shared.UI.Components.Entities.Properties
@using Nine.Shared.UI.Components.Entities.PropertyExpenses
@using Microsoft.Extensions.Options
@inject NavigationManager Navigation
@inject PropertyService PropertyService
@inject PropertyExpenseService PropertyExpenseService
@inject IOptions<ApplicationSettings> AppSettings
@namespace Nine.Shared.UI.Features.PropertyManagement.Properties

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title mb-0">Add New Property</h3>
            </div>
            <div class="card-body">
                <PropertyForm 
                    Model="@propertyModel" 
                    FormName="create-property"
                    SubmitButtonText="Create Property"
                    IsSubmitting="@isSubmitting"
                    ErrorMessage="@errorMessage"
                    OnValidSubmit="@SaveProperty"
                    OnCancel="@Cancel" />
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <PropertyExpenseList
            Expenses="@pendingExpenses"
            ShowAddButton="true"
            ShowEditButton="true"
            OnAddExpense="ShowExpenseModal"
            OnEditExpense="ShowEditExpenseModal" />
    </div>
</div>

<PropertyExpenseModal
    IsVisible="@showExpenseModal"
    IsSaving="false"
    OnSave="AddPendingExpense"
    OnCancel="CloseExpenseModal" />

<PropertyExpenseEditModal
    IsVisible="@showEditExpenseModal"
    Expense="@selectedExpense"
    SoftDeleteEnabled="@AppSettings.Value.SoftDeleteEnabled"
    OnCancelExpense="HandleCancelPendingExpense"
    OnVoidExpense="HandleVoidPendingExpense"
    OnDismiss="CloseEditExpenseModal" />

@code {
    private PropertyFormModel propertyModel = new();
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    private bool showExpenseModal = false;
    private bool showEditExpenseModal = false;
    private PropertyExpense? selectedExpense;
    private List<PropertyExpense> pendingExpenses = new();
    private Dictionary<Guid, DateTime> pendingExpenseDueDates = new();

    private async Task SaveProperty(PropertyFormModel model)
    {
        isSubmitting = true;
        errorMessage = string.Empty;

        var property = new Property
        {
            Address = model.Address,
            UnitNumber = model.UnitNumber,
            City = model.City,
            State = model.State,
            ZipCode = model.ZipCode,
            PropertyType = model.PropertyType,
            MonthlyRent = model.MonthlyRent,
            Bedrooms = model.Bedrooms,
            Bathrooms = model.Bathrooms,
            SquareFeet = model.SquareFeet,
            Description = model.Description,
            Status = model.Status,
            IsActive = model.IsActive,
        };

        var createdProperty = await PropertyService.CreateAsync(property);

        // Persist any expenses queued before the property existed.
        foreach (var expense in pendingExpenses)
        {
            expense.PropertyId = createdProperty.Id;
            var dueDate = pendingExpenseDueDates.TryGetValue(expense.Id, out var d) ? d : DateTime.Today;
            await PropertyExpenseService.CreateExpenseAsync(expense, dueDate);
        }

        isSubmitting = false;
        Navigation.NavigateTo("/propertymanagement/properties");
    }

    private void ShowExpenseModal()
    {
        showExpenseModal = true;
    }

    private void CloseExpenseModal()
    {
        showExpenseModal = false;
    }

    private void AddPendingExpense(PropertyExpenseFormModel model)
    {
        var expense = new PropertyExpense
        {
            Id = Guid.NewGuid(),
            ExpenseType = model.ExpenseType,
            Description = model.Description ?? string.Empty,
            Amount = model.Amount,
            EffectiveDate = model.DueDate,
            RecurrencePattern = new RecurrencePattern { Frequency = model.Frequency },
        };
        pendingExpenses.Add(expense);
        pendingExpenseDueDates[expense.Id] = model.DueDate;
        showExpenseModal = false;
    }

    private void RemovePendingExpense(Guid id)
    {
        pendingExpenses.RemoveAll(e => e.Id == id);
        pendingExpenseDueDates.Remove(id);
    }

    private void ShowEditExpenseModal(PropertyExpense expense)
    {
        selectedExpense = expense;
        showEditExpenseModal = true;
    }

    private void CloseEditExpenseModal()
    {
        showEditExpenseModal = false;
        selectedExpense = null;
    }

    // For pending (not yet saved) expenses, both Cancel and Void just remove from the list.
    private Task HandleCancelPendingExpense(string? reason)
    {
        if (selectedExpense != null)
            pendingExpenses.RemoveAll(e => e.Id == selectedExpense.Id);
        CloseEditExpenseModal();
        return Task.CompletedTask;
    }

    private Task HandleVoidPendingExpense()
    {
        if (selectedExpense != null)
            pendingExpenses.RemoveAll(e => e.Id == selectedExpense.Id);
        CloseEditExpenseModal();
        return Task.CompletedTask;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/propertymanagement/properties");
    }
}
