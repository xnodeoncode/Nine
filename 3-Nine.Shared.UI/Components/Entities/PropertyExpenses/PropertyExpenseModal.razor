@using Nine.Core.Constants
@using Nine.Shared.UI.Components.Common
@namespace Nine.Shared.UI.Components.Entities.PropertyExpenses

<Modal IsVisible="@IsVisible" Title="Add Property Expense" OnClose="@HandleCancel">
    <ChildContent>
        <EditForm Model="Model" OnValidSubmit="HandleValidSubmit" FormName="add-property-expense">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @ErrorMessage
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Expense Type *</label>
                <InputSelect @bind-Value="Model.ExpenseType" class="form-select">
                    @foreach (var type in ApplicationConstants.PropertyExpenseTypes.AllPropertyExpenseTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Model.ExpenseType" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label">Amount *</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <InputNumber @bind-Value="Model.Amount" class="form-control" placeholder="0.00" />
                </div>
                <ValidationMessage For="() => Model.Amount" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label">Frequency *</label>
                <InputSelect @bind-Value="Model.Frequency" class="form-select">
                    @foreach (var frequency in ApplicationConstants.ExpenseFrequencies.AllExpenseFrequencies)
                    {
                        <option value="@frequency">@frequency</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Model.Frequency" class="text-danger" />
                <div class="form-text">
                    <i class="bi bi-info-circle"></i> This amount will be allocated to a monthly equivalent for reporting purposes.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Due Date *</label>
                <InputDate @bind-Value="Model.DueDate" class="form-control" />
                <ValidationMessage For="() => Model.DueDate" class="text-danger" />
                <div class="form-text">
                    <i class="bi bi-info-circle"></i>
                    @if (Model.Frequency == ApplicationConstants.ExpenseFrequencies.OneTime)
                    {
                        <span>The exact date this expense is due.</span>
                    }
                    else
                    {
                        <span>The day (and month, for quarterly/annual) this expense recurs on going forward.</span>
                    }
                </div>
                @if (ShowsPriorYearBackfillNotice)
                {
                    <div class="alert alert-warning mt-2 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Automatic due records will only be created from January 1, @DateTime.Today.Year forward.
                        Any earlier occurrences must be entered manually.
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputText @bind-Value="Model.Description" class="form-control" placeholder="Optional details, e.g., lender or policy name" />
                <ValidationMessage For="() => Model.Description" class="text-danger" />
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-secondary" @onclick="HandleCancel">Cancel</button>
                <button type="submit" class="btn btn-primary" disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Add Expense
                </button>
            </div>
        </EditForm>
    </ChildContent>
</Modal>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public bool IsSaving { get; set; }

    [Parameter]
    public string ErrorMessage { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<PropertyExpenseFormModel> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private PropertyExpenseFormModel Model { get; set; } = new();
    private bool wasVisible;
    private DateTime CurrentYearStart => new(DateTime.Today.Year, 1, 1);
    private bool ShowsPriorYearBackfillNotice =>
        Model.Frequency != ApplicationConstants.ExpenseFrequencies.OneTime &&
        Model.DueDate.Date < CurrentYearStart;

    protected override void OnParametersSet()
    {
        // Reset to a fresh model only on the transition from hidden -> visible,
        // so in-progress input isn't wiped out on unrelated re-renders.
        if (IsVisible && !wasVisible)
        {
            Model = new PropertyExpenseFormModel();
        }
        wasVisible = IsVisible;
    }

    private async Task HandleValidSubmit()
    {
        await OnSave.InvokeAsync(Model);
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }
}
