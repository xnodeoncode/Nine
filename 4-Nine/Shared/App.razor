<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/font/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="_content/Nine.Shared.UI/css/organization-switcher.css" />
    <link rel="stylesheet" href="@Assets["co.nineapp.nine.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <!-- Load theme immediately to prevent flash -->
    <script src="_content/Nine.Shared.UI/js/theme.js"></script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="js/fileDownload.js"></script>
    <script src="js/sessionTimeout.js"></script>
    <script src="js/externalLinks.js"></script>
    @*
    SEE: https://github.com/xnodeoncode/Nine/pull/8#pullrequestreview-5931395107
    Only override external link behavior with externalLinks.js in non-Electron environments
    Per Copilot suggestion, this script should only be included in Electron environments.
    
    @if (ElectronNET.API.HybridSupport.IsElectronActive)
     {
        
        // Hands external http(s) links to the system browser (Electron build) instead of opening an app window.
        // In a normal browser the endpoint returns 404 and the link should open as usual.
        
         <script src="js/externalLinks.js"></script>
     }*@
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
