@page "/propertymanagement/documents"

@using Nine.Features.PropertyManagement
@using Nine.Core.Entities
@using Nine.Application.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject IJSRuntime JSRuntime
@inject Application.Services.DocumentService DocumentService
@inject LeaseService LeaseService
@inject PropertyService PropertyService
@inject NavigationManager Navigation

@attribute [OrganizationAuthorize("Owner", "Administrator", "PropertyManager")]
@rendermode InteractiveServer

<PageTitle>Documents - Property Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><span class="bi bi-files" aria-hidden="true"></span> Documents</h1>
        <p class="text-muted mb-0">@(showArchivedDocuments ? "Archived documents" : "Documents uploaded in the last 30 days")</p>
    </div>
</div>
<hr />
 <!-- Summary Cards -->
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h6>Lease Agreements</h6>
                    <h4>@allDocuments.Count(d => d.DocumentType == "Lease Agreement")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h6>Invoices</h6>
                    <h4>@allDocuments.Count(d => d.DocumentType == "Invoice")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h6>Payment Receipts</h6>
                    <h4>@allDocuments.Count(d => d.DocumentType == "Payment Receipt")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h6>Total Documents</h6>
                    <h4>@filteredDocuments.Count</h4>
                </div>
            </div>
        </div>
    </div>
<hr />
@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
<!-- Filters — always visible so user can toggle archived/active view -->
<div class="row mb-3">
    <div class="col-md-3">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Search documents..." @bind="searchTerm" @onkeyup="ApplyFilters" />
        </div>
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="selectedDocumentType" @bind:after="ApplyFilters">
            <option value="">All Document Types</option>
            <option value="Lease Agreement">Lease Agreement</option>
            <option value="Invoice">Invoice</option>
            <option value="Payment Receipt">Payment Receipt</option>
            <option value="Addendum">Addendum</option>
            <option value="Move-In Inspection">Move-In Inspection</option>
            <option value="Move-Out Inspection">Move-Out Inspection</option>
            <option value="Insurance">Insurance</option>
            <option value="Pet Agreement">Pet Agreement</option>
            <option value="Parking Agreement">Parking Agreement</option>
            <option value="Correspondence">Correspondence</option>
            <option value="Notice">Notice</option>
            <option value="Other">Other</option>
        </select>
    </div>
    <div class="col-md-3">
        <div class="form-check form-switch pt-2">
            <input class="form-check-input" type="checkbox" id="groupByProperty" @bind="groupByProperty" @bind:after="ApplyFilters">
            <label class="form-check-label" for="groupByProperty">
                Group by Property
            </label>
        </div>
        <div class="form-check form-switch pt-1">
            <input class="form-check-input" type="checkbox" id="showArchivedDocuments" @bind="showArchivedDocuments" @bind:after="LoadDocuments">
            <label class="form-check-label" for="showArchivedDocuments">
                Show Archived
            </label>
        </div>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-secondary" @onclick="ClearFilters">
            <i class="bi bi-x-circle"></i> Clear Filters
        </button>
    </div>
</div>

<hr />

@if (!allDocuments.Any())
{
    @if (showArchivedDocuments)
    {
        <div class="alert alert-secondary">
            <h4>No Archived Documents</h4>
            <p>No archived documents found.</p>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>No Recent Documents</h4>
            <p>No documents have been uploaded in the last 30 days.</p>
        </div>
    }
}
else
{

    <div class="card">
        <div class="card-body">
            @if (groupByProperty)
            {
                @foreach (var propertyGroup in groupedDocuments)
                {
                    var property = properties.FirstOrDefault(p => p.Id == propertyGroup.Key);
                    var propertyDocCount = propertyGroup.Count();
                    var isExpanded = expandedProperties.Contains(propertyGroup.Key.GetHashCode());
                    
                    <div class="card mb-3">
                        <div class="card-header" style="cursor: pointer;" @onclick="() => TogglePropertyGroup(propertyGroup.Key)">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                    <strong>@(property?.Address ?? "Unassigned")</strong>
                                    @if (property != null)
                                    {
                                        <span class="ms-3 text-muted">@property.City, @property.State @property.ZipCode</span>
                                    }
                                </div>
                                <div>
                                    <span class="badge bg-secondary">@propertyDocCount document(s)</span>
                                </div>
                            </div>
                        </div>
                        @if (isExpanded)
                        {
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Document</th>
                                            <th>Type</th>
                                            <th>Lease</th>
                                            <th>Size</th>
                                            <th>Uploaded</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in propertyGroup.OrderByDescending(d => d.CreatedOn))
                                        {
                                            var lease = leases.FirstOrDefault(l => l.Id == doc.LeaseId);
                                            <tr>
                                                <td>
                                                    <i class="bi @GetFileIcon(doc.FileExtension) me-2"></i>
                                                    <strong>@doc.FileName</strong>
                                                    @if (!string.IsNullOrEmpty(doc.Description))
                                                    {
                                                        <br /><small class="text-muted">@doc.Description</small>
                                                    }
                                                </td>
                                                <td><span class="badge @GetDocumentTypeBadge(doc.DocumentType)">@doc.DocumentType</span></td>
                                                <td>
                                                    @if (lease != null)
                                                    {
                                                        <span>@lease.Tenant?.FullName</span>
                                                        <br /><small class="text-muted">@lease.StartDate.ToString("MMM yyyy") - @lease.EndDate.ToString("MMM yyyy")</small>
                                                    }
                                                </td>
                                                <td>@doc.FileSizeFormatted</td>
                                                <td>
                                                    @doc.CreatedOn.ToString("MMM dd, yyyy")
                                                    <br /><small class="text-muted">@doc.CreatedBy</small>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-info" @onclick="() => ViewDocument(doc)" title="View">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button class="btn btn-outline-primary" @onclick="() => DownloadDocument(doc)" title="Download">
                                                            <i class="bi bi-download"></i>
                                                        </button>
                                                        <button class="btn btn-outline-secondary" @onclick="() => GoToRelatedRecord(doc)" title="@GetRelatedRecordLabel(doc)">
                                                            <i class="bi @GetRelatedRecordIcon(doc)"></i>
                                                        </button>
                                                        @if (!doc.IsArchived)
                                                        {
                                                            <button class="btn btn-outline-warning" @onclick="() => ArchiveDocument(doc)" title="Archive">
                                                                <i class="bi bi-archive"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-outline-success" @onclick="() => UnarchiveDocument(doc)" title="Restore">
                                                                <i class="bi bi-arrow-counterclockwise"></i>
                                                            </button>
                                                        }
                                                        <button class="btn btn-outline-danger" @onclick="() => ShowDeleteModal(doc.Id)" title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>
                                    <button class="btn btn-link p-0 text-decoration-none text-dark fw-bold" @onclick="() => SortBy(nameof(Document.FileName))">
                                        Document
                                        @if (sortColumn == nameof(Document.FileName))
                                        {
                                            <i class="bi @(sortAscending ? "bi-caret-up" : "bi-caret-down")"></i>
                                        }
                                    </button>
                                </th>
                                <th>
                                    <button class="btn btn-link p-0 text-decoration-none text-dark fw-bold" @onclick="() => SortBy(nameof(Document.DocumentType))">
                                        Type
                                        @if (sortColumn == nameof(Document.DocumentType))
                                        {
                                            <i class="bi @(sortAscending ? "bi-caret-up" : "bi-caret-down")"></i>
                                        }
                                    </button>
                                </th>
                                <th>
                                    <button class="btn btn-link p-0 text-decoration-none text-dark fw-bold" @onclick='() => SortBy("PropertyAddress")'>
                                        Property
                                        @if (sortColumn == "PropertyAddress")
                                        {
                                            <i class="bi @(sortAscending ? "bi-caret-up" : "bi-caret-down")"></i>
                                        }
                                    </button>
                                </th>
                                <th>Lease</th>
                                <th>Size</th>
                                <th>
                                    <button class="btn btn-link p-0 text-decoration-none text-dark fw-bold" @onclick="() => SortBy(nameof(Document.CreatedOn))">
                                        Uploaded
                                        @if (sortColumn == nameof(Document.CreatedOn))
                                        {
                                            <i class="bi @(sortAscending ? "bi-caret-up" : "bi-caret-down")"></i>
                                        }
                                    </button>
                                </th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in pagedDocuments)
                            {
                                var lease = leases.FirstOrDefault(l => l.Id == doc.LeaseId);
                                var property = properties.FirstOrDefault(p => p.Id == doc.PropertyId);
                                <tr>
                                    <td>
                                        <i class="bi @GetFileIcon(doc.FileExtension) me-2"></i>
                                        <strong>@doc.FileName</strong>
                                        @if (showArchivedDocuments)
                                        {
                                            <span class="badge bg-secondary ms-1">Archived</span>
                                        }
                                        @if (!string.IsNullOrEmpty(doc.Description))
                                        {
                                            <br /><small class="text-muted">@doc.Description</small>
                                        }
                                    </td>
                                    <td><span class="badge @GetDocumentTypeBadge(doc.DocumentType)">@doc.DocumentType</span></td>
                                    <td>
                                        @if (property != null)
                                        {
                                            <span>@property.Address</span>
                                            <br /><small class="text-muted">@property.City, @property.State</small>
                                        }
                                    </td>
                                    <td>
                                        @if (lease != null)
                                        {
                                            <span>@lease.Tenant?.FullName</span>
                                            <br /><small class="text-muted">@lease.StartDate.ToString("MMM yyyy") - @lease.EndDate.ToString("MMM yyyy")</small>
                                        }
                                    </td>
                                    <td>@doc.FileSizeFormatted</td>
                                    <td>
                                        @doc.CreatedOn.ToString("MMM dd, yyyy")
                                        <br /><small class="text-muted">@doc.CreatedBy</small>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-info" @onclick="() => ViewDocument(doc)" title="View">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-outline-primary" @onclick="() => DownloadDocument(doc)" title="Download">
                                                <i class="bi bi-download"></i>
                                            </button>
                                            <button class="btn btn-outline-secondary" @onclick="() => GoToRelatedRecord(doc)" title="@GetRelatedRecordLabel(doc)">
                                                <i class="bi @GetRelatedRecordIcon(doc)"></i>
                                            </button>
                                            @if (!doc.IsArchived)
                                            {
                                                <button class="btn btn-outline-warning" @onclick="() => ArchiveDocument(doc)" title="Archive">
                                                    <i class="bi bi-archive"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-success" @onclick="() => UnarchiveDocument(doc)" title="Restore">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                            <button class="btn btn-outline-danger" @onclick="() => ShowDeleteModal(doc.Id)" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Document navigation" class="mt-3">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage == 1)">Previous</button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage == totalPages)">Next</button>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
}

<ActionConfirmModal IsVisible="@_showDeleteModal" Variant="danger"
    Title="Delete Document" ConfirmText="Delete Permanently"
    Cascade="@_cascade" IsProcessing="@_isProcessing"
    OnConfirm="ConfirmDelete" OnCancel="CloseDeleteModal" />

@code {
    private Guid _pendingDocId;
    private CascadeSummary? _cascade;
    private bool _showDeleteModal;
    private bool _isProcessing;

    private bool isLoading = true;
    private bool showArchivedDocuments = false;
    private List<Document> allDocuments = new();
    private List<Document> filteredDocuments = new();
    private List<Document> pagedDocuments = new();
    private List<Lease> leases = new();
    private List<Property> properties = new();
    
    private string searchTerm = string.Empty;
    private string selectedDocumentType = string.Empty;
    private bool groupByProperty = true;
    private HashSet<int> expandedProperties = new();
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPages = 1;
    
    // Sorting
    private string sortColumn = nameof(Document.CreatedOn);
    private bool sortAscending = false;

    private IEnumerable<IGrouping<Guid, Document>> groupedDocuments = Enumerable.Empty<IGrouping<Guid, Document>>();

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    [Parameter]
    [SupplyParameterFromQuery]
    public Guid? PropertyId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        isLoading = true;
        try
        {
            var authState = await AuthenticationStateTask;
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                return;
            }

            // Load documents with navigation properties included. Using GetDocumentsWithRelationsAsync
            // ensures property/lease info is available even for archived properties — documents
            // associated with an archived property should still be visible and grouped correctly.
            var allUserDocs = await DocumentService.GetDocumentsWithRelationsAsync(showArchivedDocuments);
            if (showArchivedDocuments)
            {
                allDocuments = allUserDocs
                    .Where(d => d.IsArchived)
                    .OrderByDescending(d => d.ArchivedOn)
                    .ToList();
            }
            else
            {
                allDocuments = allUserDocs
                    .OrderByDescending(d => d.CreatedOn)
                    .ToList();
            }

            // Derive properties and leases from the loaded documents so that archived
            // properties are included for grouping and display purposes.
            properties = allDocuments
                .Where(d => d.Property != null)
                .Select(d => d.Property!)
                .DistinctBy(p => p.Id)
                .ToList();

            leases = allDocuments
                .Where(d => d.Lease != null)
                .Select(d => d.Lease!)
                .DistinctBy(l => l.Id)
                .ToList();

            ApplyFilters();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredDocuments = allDocuments;

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredDocuments = filteredDocuments
                .Where(d => d.FileName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                           (d.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }

        // Apply document type filter
        if (!string.IsNullOrWhiteSpace(selectedDocumentType))
        {
            filteredDocuments = filteredDocuments
                .Where(d => d.DocumentType == selectedDocumentType)
                .ToList();
        }

        if(PropertyId.HasValue)
        {
            filteredDocuments = filteredDocuments
                .Where(d => d.PropertyId == PropertyId.Value)
                .ToList();
        }

        // Apply sorting
        ApplySorting();

        if (groupByProperty)
        {
            groupedDocuments = filteredDocuments
                .Where(d => d.PropertyId.HasValue && d.PropertyId.Value != Guid.Empty)
                .GroupBy(d => d.PropertyId!.Value)
                .OrderBy(g => properties.FirstOrDefault(p => p.Id == g.Key)?.Address ?? "");
        }
        else
        {
            // Pagination for flat view
            totalPages = (int)Math.Ceiling(filteredDocuments.Count / (double)pageSize);
            currentPage = Math.Max(1, Math.Min(currentPage, totalPages == 0 ? 1 : totalPages));
            UpdatePagedDocuments();
        }

        StateHasChanged();
    }

    private void ApplySorting()
    {
        filteredDocuments = sortColumn switch
        {
            nameof(Document.FileName) => sortAscending 
                ? filteredDocuments.OrderBy(d => d.FileName).ToList()
                : filteredDocuments.OrderByDescending(d => d.FileName).ToList(),
            nameof(Document.DocumentType) => sortAscending
                ? filteredDocuments.OrderBy(d => d.DocumentType).ToList()
                : filteredDocuments.OrderByDescending(d => d.DocumentType).ToList(),
            nameof(Document.CreatedOn) => sortAscending
                ? filteredDocuments.OrderBy(d => d.CreatedOn).ToList()
                : filteredDocuments.OrderByDescending(d => d.CreatedOn).ToList(),
            "PropertyAddress" => sortAscending
                ? filteredDocuments.OrderBy(d => properties.FirstOrDefault(p => p.Id == d.PropertyId)?.Address ?? string.Empty).ToList()
                : filteredDocuments.OrderByDescending(d => properties.FirstOrDefault(p => p.Id == d.PropertyId)?.Address ?? string.Empty).ToList(),
            _ => filteredDocuments.OrderByDescending(d => d.CreatedOn).ToList()
        };
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        ApplyFilters();
    }

    private void UpdatePagedDocuments()
    {
        pagedDocuments = filteredDocuments
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void ChangePage(int page)
    {
        currentPage = page;
        UpdatePagedDocuments();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedDocumentType = string.Empty;
        groupByProperty = false;
        PropertyId = null;
        ApplyFilters();
    }

    private void TogglePropertyGroup(Guid propertyId)
    {
        if (expandedProperties.Contains(propertyId.GetHashCode()))
        {
            expandedProperties.Remove(propertyId.GetHashCode());
        }
        else
        {
            expandedProperties.Add(propertyId.GetHashCode());
        }
    }

    private async Task ViewDocument(Document doc)
    {
        var base64Data = Convert.ToBase64String(doc.FileData);
        await JSRuntime.InvokeVoidAsync("viewFile", base64Data, doc.FileType);
    }

    private async Task DownloadDocument(Document doc)
    {
        var fileName = doc.FileName;
        var fileData = doc.FileData;
        var mimeType = doc.FileType;

        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(fileData), mimeType);
    }

    private void GoToRelatedRecord(Document doc)
    {
        if (doc.LeaseId.HasValue)
            Navigation.NavigateTo($"/propertymanagement/leases/{doc.LeaseId.Value}");
        else if (doc.TenantId.HasValue)
            Navigation.NavigateTo($"/propertymanagement/tenants/{doc.TenantId.Value}");
        else if (doc.InvoiceId.HasValue)
            Navigation.NavigateTo($"/propertymanagement/invoices/{doc.InvoiceId.Value}");
        else if (doc.PaymentId.HasValue)
            Navigation.NavigateTo($"/propertymanagement/payments/{doc.PaymentId.Value}");
        else if (doc.RepairId.HasValue)
            Navigation.NavigateTo($"/propertymanagement/repairs/{doc.RepairId.Value}");
        else if (doc.PropertyId.HasValue)
            Navigation.NavigateTo($"/propertymanagement/properties/{doc.PropertyId.Value}");
    }

    private string GetRelatedRecordLabel(Document doc)
    {
        if (doc.LeaseId.HasValue) return "View Lease";
        if (doc.TenantId.HasValue) return "View Tenant";
        if (doc.InvoiceId.HasValue) return "View Invoice";
        if (doc.PaymentId.HasValue) return "View Payment";
        if (doc.RepairId.HasValue) return "View Repair";
        return "View Property";
    }

    private string GetRelatedRecordIcon(Document doc)
    {
        if (doc.LeaseId.HasValue) return "bi-file-text";
        if (doc.TenantId.HasValue) return "bi-person";
        if (doc.InvoiceId.HasValue) return "bi-receipt";
        if (doc.PaymentId.HasValue) return "bi-cash";
        if (doc.RepairId.HasValue) return "bi-tools";
        return "bi-house";
    }

    private async Task ShowDeleteModal(Guid id)
    {
        _pendingDocId = id;
        _cascade = await DocumentService.GetDeleteCascadeSummaryAsync(id);
        _showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        _isProcessing = true;
        await DocumentService.DeleteAsync(_pendingDocId);
        _isProcessing = false;
        CloseDeleteModal();
        await LoadDocuments();
    }

    private void CloseDeleteModal()
    {
        _showDeleteModal = false;
        _cascade = null;
    }

    private string GetFileIcon(string extension)
    {
        return extension.ToLower() switch
        {
            ".pdf" => "bi-file-pdf text-danger",
            ".doc" or ".docx" => "bi-file-word text-primary",
            ".jpg" or ".jpeg" or ".png" => "bi-file-image text-success",
            ".txt" => "bi-file-text",
            _ => "bi-file-earmark"
        };
    }

    private string GetDocumentTypeBadge(string documentType)
    {
        return documentType switch
        {
            "Lease Agreement" => "bg-primary",
            "Invoice" => "bg-warning",
            "Payment Receipt" => "bg-success",
            "Addendum" => "bg-info",
            "Move-In Inspection" or "Move-Out Inspection" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private async Task ArchiveDocument(Document doc)
    {
        try
        {
            await DocumentService.ArchiveAsync(doc.Id);
            await LoadDocuments();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error archiving document: {ex.Message}");
        }
    }

    private async Task UnarchiveDocument(Document doc)
    {
        try
        {
            await DocumentService.RestoreAsync(doc.Id);
            await LoadDocuments();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error unarchiving document: {ex.Message}");
        }
    }
}